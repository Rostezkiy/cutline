{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cutline",
  "version": "1.0.0",
  "identifier": "ru.r057.cutline",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cutline — запуск…",
        "url": "index.html",
        "width": 1024,
        "height": 640,
        "minWidth": 800,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
